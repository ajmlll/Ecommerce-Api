# Application Configuration
PORT=5000 # Port number for the HTTP server
NODE_ENV=development # Environment mode (development, production, test)

# Database Configuration
MONGO_URI=mongodb://localhost:27017/ecommerce_db # MongoDB connection string

# JSON Web Token (JWT) Configuration
JWT_SECRET=your_super_secret_jwt_key_here # Secret key used for signing JWT tokens
JWT_EXPIRES_IN=7d # Expiration time for JWT tokens (e.g., 1h, 7d, 30d)
